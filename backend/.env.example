# Database Setup (Default: Local SQLite | Supabase: PostgreSQL URI)
# For Supabase, uncomment and fill in your connection string from Project Settings -> Database -> Connection URI:
# DATABASE_URL=postgresql://postgres.[PROJECT_ID]:[YOUR_PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres
DATABASE_URL=sqlite:///./truthlens.db

# Supabase Credentials (Optional - for Supabase Auth / Client SDK)
SUPABASE_URL=https://YOUR_SUPABASE_PROJECT_ID.supabase.co
SUPABASE_KEY=YOUR_SUPABASE_ANON_OR_SERVICE_KEY

# API & Server Setup
GOOGLE_PLACES_API_KEY=YOUR_GOOGLE_PLACES_API_KEY_HERE
PORT=8000
HOST=0.0.0.0
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

